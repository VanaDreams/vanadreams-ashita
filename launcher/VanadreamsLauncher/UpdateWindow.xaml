<Window x:Class="Vanadreams.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vanadreams Launcher update" Icon="assets/moon.ico" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowSky}"
        FontFamily="{StaticResource Body}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource Box}" Margin="14">
        <StackPanel>
            <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Launcher update"/>
            <TextBlock x:Name="Heading" Style="{StaticResource Display40}" FontSize="26" TextWrapping="Wrap"/>
            <TextBlock x:Name="Body" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0"/>
            <ProgressBar x:Name="Bar" Margin="0,16,0,0" Maximum="1"/>
            <TextBlock x:Name="BarLine" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" Text="Moogling in progress…"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="LaterButton" Style="{StaticResource GhostButton}" Content="Later" Padding="16,6" IsCancel="True"/>
                <Button x:Name="UpdateButton" Style="{StaticResource GoldButton}" Content="Update and restart" Padding="18,6" Margin="10,0,0,0"
                        IsDefault="True" IsEnabled="False" Click="Update_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
