<UserControl x:Class="Vanadreams.Pages.AddonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vanadreams"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Coming from Windower?" FontSize="12.5" Padding="10,1"
                            VerticalAlignment="Top" Margin="8,0,0,0" Click="Windower_Click"
                            ToolTip="Ashita look-alikes of your Windower addons, your init.txt binds, and your GearSwap sets"/>
                    <TextBlock x:Name="Heading" Style="{StaticResource Eyebrow}" Text="✦ Your addons" TextWrapping="Wrap"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="List" SizeChanged="List_SizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- two columns when the box is wide (menu across the top), one when it is not: List_SizeChanged -->
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="27" Margin="0,0,12,0" Background="Transparent" MouseLeftButtonUp="Row_Click" Tag="{Binding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Hand}" FontSize="18" Margin="0,-3,0,0" Visibility="{Binding HandVisibility}"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanTick}" VerticalAlignment="Center" Click="Check_Click" Tag="{Binding}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center" Opacity="{Binding Opacity}" TextWrapping="Wrap" Margin="0,3"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Tag}" FontSize="11" FontWeight="ExtraBold" Foreground="{Binding TagBrush}" VerticalAlignment="Center" Typography.Capitals="AllSmallCaps" Margin="4,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Selected"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="ItemName" Style="{StaticResource Display40}" FontSize="27" Text="—" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ItemMeta" Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ItemDesc" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ItemState" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock x:Name="ItemV3" Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="Progress" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="ProgressText" Style="{StaticResource Muted}" FontSize="13.5" Visibility="Collapsed" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <WrapPanel>
                        <Button x:Name="InstallButton" Style="{StaticResource GoldButton}" Content="Install" Click="Install_Click" Margin="0,0,7,7" MinWidth="110"/>
                        <Button x:Name="DocsButton" Style="{StaticResource GhostButton}" Content="Read the docs" Click="Docs_Click" Margin="0,0,7,7"/>
                        <Button x:Name="ConfigButton" Style="{StaticResource GhostButton}" Content="Open config folder" Click="Config_Click" Margin="0,0,7,7"/>
                        <Button x:Name="SwitcherButton" Style="{StaticResource GhostButton}" Content="Switcher settings" Click="Switcher_Click" Margin="0,0,7,7" Visibility="Collapsed"/>
                    </WrapPanel>
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Left" Style="{StaticResource GoldButton}" Content="Save" Click="Save_Click" MinWidth="110" VerticalAlignment="Center"
                                ToolTip="Save writes scripts\vanadreams.txt and the POL plugin flags."/>
                        <TextBlock x:Name="Footer" Style="{StaticResource Muted}" FontSize="13" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- under the buttons, never over them -->
                    <local:CrewGuide Who="goblin" BubbleWidth="140"
                                     Tip="Tinker tinker. Updates install themselves when you press Play."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
