<UserControl x:Class="Vanadreams.Pages.SwitcherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="270"/>
        </Grid.ColumnDefinitions>

        <!-- six slot rows, then the two layout rows and the auto-place tick -->
        <Border Grid.Column="0" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Heading" Style="{StaticResource Eyebrow}" Text="✦ Game windows"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Slots">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="31">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                                        <TextBlock Text="{Binding Label}" FontSize="15" Opacity="{Binding Opacity}" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding StatusTip}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="9,2" FontSize="13" Margin="4,0,5,0" MinWidth="96"
                                            Content="{Binding KeyText}" Visibility="{Binding KeyVisibility}" Tag="{Binding}" Click="SlotKey_Click"
                                            ToolTip="The key that brings this slot forward. Click, then press the key; Esc clears it."/>
                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Padding="0,2" FontSize="13" Margin="0,0,4,0" Content="▲"
                                            IsEnabled="{Binding CanUp}" Tag="{Binding}" Click="Up_Click" ToolTip="Move this character up a slot"/>
                                    <Button Grid.Column="4" Style="{StaticResource GhostButton}" Padding="0,2" FontSize="13" Margin="0,0,4,0" Content="▼"
                                            IsEnabled="{Binding CanDown}" Tag="{Binding}" Click="Down_Click" ToolTip="Move this character down a slot"/>
                                    <Button Grid.Column="5" Style="{StaticResource GhostButton}" Padding="0,2" FontSize="13" Content="Show"
                                            IsEnabled="{Binding HasWindow}" Tag="{Binding}" Click="Show_Click" ToolTip="Bring this window to the front"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Style="{StaticResource Eyebrow}" Text="✦ Layouts" Margin="0,8,0,6"/>
                <WrapPanel Grid.Row="3">
                    <ComboBox x:Name="LayoutBox" Width="180" VerticalAlignment="Center" Margin="0,0,8,6" ToolTip="Your saved layouts"/>
                    <Button Style="{StaticResource GhostButton}" Padding="13,4" Content="Restore" Margin="0,0,8,6" Click="Restore_Click"
                            ToolTip="Put every window back where this layout has it"/>
                    <Button Style="{StaticResource GhostButton}" Padding="13,4" Content="Delete" Margin="0,0,0,6" Click="Delete_Click"/>
                </WrapPanel>
                <WrapPanel Grid.Row="4">
                    <TextBox x:Name="LayoutName" Width="180" VerticalAlignment="Center" Margin="0,0,8,6" ToolTip="A name for the layout, e.g. Full party"/>
                    <Button Style="{StaticResource GhostButton}" Padding="13,4" Content="Save windows as this layout" Margin="0,0,0,6" Click="Save_Click"/>
                </WrapPanel>
                <CheckBox Grid.Row="5" x:Name="AutoLayoutBox" Margin="0,4,0,0" Click="AutoLayout_Click">
                    <TextBlock Text="Put each character in its place in the layout as it logs in" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock Grid.Row="6" x:Name="LayoutNote" Style="{StaticResource Muted}" FontSize="13.5" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Window switcher"/>
                <CheckBox Grid.Row="1" x:Name="OnBox" Click="On_Click">
                    <TextBlock Text="On: switch between my game windows" TextWrapping="Wrap" FontWeight="SemiBold"/>
                </CheckBox>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Next" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="NextKey" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="13.5" Tag="next" Click="Key_Click"
                            ToolTip="Click, then press the key; Esc clears it"/>
                    <TextBlock Grid.Row="1" Text="Previous" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Button Grid.Row="1" Grid.Column="1" x:Name="PrevKey" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="13.5" Tag="prev" Click="Key_Click"
                            ToolTip="Click, then press the key; Esc clears it"/>
                    <TextBlock Grid.Row="2" Text="Pad next" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="PadNextBox" VerticalAlignment="Center" FontSize="13.5" SelectionChanged="Pad_Changed"/>
                    <TextBlock Grid.Row="3" Text="Pad previous" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="PadPrevBox" VerticalAlignment="Center" FontSize="13.5" SelectionChanged="Pad_Changed"/>
                </Grid>
                <CheckBox Grid.Row="3" x:Name="AnywhereBox" Margin="0,8,0,0" Click="Anywhere_Click"
                          ToolTip="Off: the keys only work while a game window is in front, so they never get in the way elsewhere.">
                    <TextBlock Text="Keys work from any window, not just the game" TextWrapping="Wrap" FontSize="14.5"/>
                </CheckBox>
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <TextBlock x:Name="Note" Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap"/>
                </ScrollViewer>
                <Button Grid.Row="5" Style="{StaticResource GhostButton}" Content="Back" HorizontalAlignment="Left" Margin="0,6,0,0" Click="Back_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
