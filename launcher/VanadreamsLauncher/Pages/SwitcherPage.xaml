<UserControl x:Class="Vanadreams.Pages.SwitcherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="40,36,40,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 404 high, the same as the menu's boxes: six 30-high slot rows, then the two layout rows and the auto-place tick -->
        <Border Grid.Column="0" Style="{StaticResource Box}" Height="404" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="182"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Heading" Style="{StaticResource Eyebrow}" Text="✦ Game windows"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Slots">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="14" Opacity="{Binding Opacity}" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding StatusTip}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="12" Margin="0,0,6,0"
                                            Content="{Binding KeyText}" Visibility="{Binding KeyVisibility}" Tag="{Binding}" Click="SlotKey_Click"
                                            ToolTip="The key that brings this slot forward. Click, then press the key; Esc clears it."/>
                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Padding="0,3" FontSize="12" Margin="0,0,4,0" Content="▲"
                                            IsEnabled="{Binding CanUp}" Tag="{Binding}" Click="Up_Click" ToolTip="Move this character up a slot"/>
                                    <Button Grid.Column="4" Style="{StaticResource GhostButton}" Padding="0,3" FontSize="12" Margin="0,0,4,0" Content="▼"
                                            IsEnabled="{Binding CanDown}" Tag="{Binding}" Click="Down_Click" ToolTip="Move this character down a slot"/>
                                    <Button Grid.Column="5" Style="{StaticResource GhostButton}" Padding="0,3" FontSize="12" Content="Show"
                                            IsEnabled="{Binding HasWindow}" Tag="{Binding}" Click="Show_Click" ToolTip="Bring this window to the front"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Style="{StaticResource Eyebrow}" Text="✦ Layouts" Margin="0,8,0,8"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <ComboBox x:Name="LayoutBox" Width="200" VerticalAlignment="Center" ToolTip="Your saved layouts"/>
                    <Button Style="{StaticResource GhostButton}" Padding="14,5" Content="Restore" Margin="8,0,0,0" Click="Restore_Click"
                            ToolTip="Put every window back where this layout has it"/>
                    <Button Style="{StaticResource GhostButton}" Padding="14,5" Content="Delete" Margin="8,0,0,0" Click="Delete_Click"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="LayoutName" Width="200" VerticalAlignment="Center" ToolTip="A name for the layout, e.g. Full party"/>
                    <Button Style="{StaticResource GhostButton}" Padding="14,5" Content="Save windows as this layout" Margin="8,0,0,0" Click="Save_Click"/>
                </StackPanel>
                <CheckBox Grid.Row="5" x:Name="AutoLayoutBox" Margin="0,10,0,0" Click="AutoLayout_Click"
                          Content="Put each character in its place in the layout as it logs in"/>
                <TextBlock Grid.Row="6" x:Name="LayoutNote" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Box}" Height="404" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Window switcher"/>
                <CheckBox Grid.Row="1" x:Name="OnBox" Click="On_Click">
                    <TextBlock Text="On: switch between my game windows" TextWrapping="Wrap" FontWeight="SemiBold"/>
                </CheckBox>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Next" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="NextKey" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12" Tag="next" Click="Key_Click"
                            ToolTip="Click, then press the key; Esc clears it"/>
                    <TextBlock Grid.Row="1" Text="Previous" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Button Grid.Row="1" Grid.Column="1" x:Name="PrevKey" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12" Tag="prev" Click="Key_Click"
                            ToolTip="Click, then press the key; Esc clears it"/>
                    <TextBlock Grid.Row="2" Text="Pad next" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="PadNextBox" VerticalAlignment="Center" FontSize="12" SelectionChanged="Pad_Changed"/>
                    <TextBlock Grid.Row="3" Text="Pad previous" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="PadPrevBox" VerticalAlignment="Center" FontSize="12" SelectionChanged="Pad_Changed"/>
                </Grid>
                <CheckBox Grid.Row="3" x:Name="AnywhereBox" Margin="0,10,0,0" Click="Anywhere_Click"
                          ToolTip="Off: the keys only work while a game window is in front, so they never get in the way elsewhere.">
                    <TextBlock Text="Keys work from any window, not just the game" TextWrapping="Wrap" FontSize="13"/>
                </CheckBox>
                <TextBlock Grid.Row="4" x:Name="Note" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <Button Grid.Row="5" Style="{StaticResource GhostButton}" Content="Back" HorizontalAlignment="Left" Click="Back_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
