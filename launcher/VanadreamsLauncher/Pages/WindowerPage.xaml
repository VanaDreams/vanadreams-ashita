<UserControl x:Class="Vanadreams.Pages.WindowerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="40,36,40,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Coming from Windower"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Vanadreams plays through Ashita. These three bring over what you had on Windower, so it feels like home."/>

                <!-- 1. the look-alikes -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MenuItemText}" FontSize="17" Text="1. Your addons, Ashita's way"/>
                        <TextBlock x:Name="PresetList" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="PresetButton" Style="{StaticResource GoldButton}" Content="Install and tick" VerticalAlignment="Center" Click="Preset_Click"/>
                </Grid>

                <!-- 2. init.txt -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MenuItemText}" FontSize="17" Text="2. Your binds and aliases"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                   Text="Reads Windower's scripts\init.txt and writes its binds and aliases into your Vanadreams startup script."/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="InitButton" Style="{StaticResource GoldButton}" Content="Import init.txt…" VerticalAlignment="Center" Click="Init_Click"/>
                </Grid>

                <!-- 3. GearSwap -->
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MenuItemText}" FontSize="17" Text="3. Your GearSwap sets"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                   Text="Pick your GearSwap job files. Each job becomes a LuAshitacast profile with all your sets in it. Your rules stay behind: you get standard ones to tweak."/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Text="Character name" Margin="0,0,8,0"/>
                            <TextBox x:Name="CharacterBox" Width="160" VerticalAlignment="Center" ToolTip="Used for files named only by job, like WHM.lua"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="GearSwapButton" Style="{StaticResource GoldButton}" Content="Import GearSwap…" VerticalAlignment="Center" Click="GearSwap_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ What happened"/>
                <StackPanel Grid.Row="1">
                    <ProgressBar x:Name="Progress" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <ScrollViewer x:Name="ResultScroll" MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="Result" TextWrapping="Wrap" FontSize="13" Text="Nothing yet. Each step can be run again whenever you like."/>
                    </ScrollViewer>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button x:Name="OpenButton" Style="{StaticResource GhostButton}" Content="Open the folder" Click="Open_Click" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <Button Style="{StaticResource GhostButton}" Content="Back" HorizontalAlignment="Left" Click="Back_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
