<UserControl x:Class="Vanadreams.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vanadreams"
             Focusable="True">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.8*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Settings"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="166"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="Auto" MinHeight="32"/>
                            <RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="Auto" MinHeight="32"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- the label and what it does above the two buttons, so neither crowds the other -->
                        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <TextBlock Text="Menu layout" FontWeight="SemiBold"/>
                            <TextBlock Text="The menu down the left, or tabs across the top" Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="VerticalButton" Content="Vertical" Padding="14,3" Tag="vertical" Click="Layout_Click"/>
                                <Button x:Name="HorizontalButton" Content="Horizontal" Padding="14,3" Margin="6,0,0,0" Tag="horizontal" Click="Layout_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Ashita folder" Style="{StaticResource Label}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="AshitaBox" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Text="Vanadreams game folder" Style="{StaticResource Label}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="FfxiBox" VerticalAlignment="Center"
                                 ToolTip="Blank: the launcher picks the copy that fits the server. A FINAL FANTASY XI folder here is always the one Vanadreams plays (same as the Game folder box on a Vanadreams profile)."/>
                        <TextBlock Grid.Row="3" Text="Catalogue address" Style="{StaticResource Label}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="CatalogBox" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Text="Status address" Style="{StaticResource Label}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="StatusBox" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Text="Server's client version" Style="{StaticResource Label}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ExpectedBox" Style="{StaticResource Mono}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="6" Text="Vanadreams plays" Style="{StaticResource Label}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="DetectedBox" Style="{StaticResource Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <!-- the effects (Low spec) are the Graphics page's presets now, per profile -->
                        <TextBlock Grid.Row="7" Text="Music" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,7,8,0"/>
                        <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,7,0,0">
                            <CheckBox x:Name="MusicBox">
                                <TextBlock Text="Play “The Lanterns Are Lit” while the launcher is open" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock x:Name="MusicCredit" Style="{StaticResource Muted}" FontSize="13.5" Margin="20,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource GoldButton}" Content="Save" Click="Save_Click" MinWidth="110"/>
                    <TextBlock x:Name="Note" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="320"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ About"/>
                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="About" Style="{StaticResource Muted}" FontSize="14.5" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource GhostButton}" Content="Refresh catalogue" Margin="0,0,7,7" Click="Catalog_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="Open data folder" Margin="0,0,7,7" Click="Data_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="Open log" Margin="0,0,7,7" Click="Log_Click"/>
                        <Button x:Name="ShortcutsButton" Style="{StaticResource GhostButton}" Content="Install shortcuts" Margin="0,0,7,7" Click="Shortcuts_Click"/>
                    </WrapPanel>
                </StackPanel>
                <local:CrewGuide Grid.Row="2" Who="orc" BubbleWidth="140"
                                 Tip="Settings is orc's job. Orc keep things tidy."/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
