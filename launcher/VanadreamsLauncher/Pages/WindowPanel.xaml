<UserControl x:Class="Vanadreams.Pages.WindowPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The game window for the current profile: mode, size, display and frame rate. Self-contained: drop it in any box. -->
    <StackPanel>
        <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Window"/>
        <TextBlock Style="{StaticResource Display40}" FontSize="27" Text="Window and speed" Margin="0,0,0,10"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Window" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            <WrapPanel Grid.Column="1" x:Name="Modes"/>
            <TextBlock Grid.Row="1" Text="Size" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            <WrapPanel Grid.Row="1" Grid.Column="1" x:Name="Sizes"/>
            <TextBlock Grid.Row="2" Text="Monitor" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="MonitorBox" HorizontalAlignment="Left" MinWidth="170" FontSize="14" Margin="0,0,0,8"
                      SelectionChanged="Monitor_Changed" ToolTip="The display the game opens on"/>
            <TextBlock Grid.Row="3" Text="FPS cap" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            <WrapPanel Grid.Row="3" Grid.Column="1" x:Name="Rates"/>
        </Grid>
    </StackPanel>
</UserControl>
