<UserControl x:Class="Vanadreams.Pages.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vanadreams"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ What it does"/>
                <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Installs Final Fantasy XI, already updated to the version Vanadreams runs. No PlayOnline and no Square Enix account: the launcher downloads the game, checks every part, and sets it up so Play works. Windows asks for permission once at the end, to register the game."/>
                <Grid Grid.Row="2" x:Name="Facts">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Muted}" Text="Version" Margin="0,0,0,5"/>
                    <TextBlock Grid.Column="1" x:Name="VersionText" Style="{StaticResource Mono}" Margin="0,0,0,5" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="Download" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SizeText" Style="{StaticResource Mono}" Margin="0,0,0,5" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Text="Install to" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FolderText" Style="{StaticResource Mono}" Margin="0,0,0,5" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Text="Game now" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FoundText" Style="{StaticResource Mono}" Margin="0,0,0,5" TextWrapping="Wrap"/>
                </Grid>
                <StackPanel Grid.Row="4">
                    <ProgressBar x:Name="Progress" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Game"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Display40}" FontSize="29" Text="Final Fantasy XI" TextWrapping="Wrap"/>
                        <TextBlock x:Name="State" Style="{StaticResource Mono}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <WrapPanel>
                        <Button x:Name="InstallButton" Style="{StaticResource GoldButton}" Content="Install game" Click="Install_Click" Margin="0,0,7,7"/>
                        <Button x:Name="FolderButton" Style="{StaticResource GhostButton}" Content="Change folder" Click="Folder_Click" Margin="0,0,0,7"/>
                    </WrapPanel>
                    <local:CrewGuide Who="orc" BubbleWidth="140"
                                     Tip="Big download? Orc carry it. Stop any time, it picks up where it left off."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
