<UserControl x:Class="Vanadreams.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vanadreams"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Profiles"/>
                <ListBox Grid.Row="1" x:Name="List" Background="Transparent" BorderThickness="0" SelectionChanged="List_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Height="34" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="hand" Style="{StaticResource Hand}" Visibility="Hidden" FontSize="22"/>
                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="hand" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource MenuItemText}" FontSize="20" Opacity="{Binding Opacity}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Grid.Row="2" Margin="0,4,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="New" Padding="11,5" Margin="0,0,5,5" Click="New_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="Retail" Padding="11,5" Margin="0,0,5,5" Click="Retail_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="Copy" Padding="11,5" Margin="0,0,5,5" Click="Duplicate_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="Delete" Padding="11,5" Margin="0,0,0,5" Click="Delete_Click"/>
                </WrapPanel>
                <!-- the last thing in the box: the moogle takes its own room, under the buttons -->
                <local:CrewGuide Grid.Row="3" Who="moogle" ImageHeight="92" BubbleWidth="114"
                                 Tip="Kupo! Each profile keeps its own login, window size and macros."/>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Profile"/>
                <Grid Grid.Row="1" x:Name="Form">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="126"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                        <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Name" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="NameBox" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="Server address" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ServerBox" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="TailscaleBox" Content="Over Tailscale" VerticalAlignment="Center" Margin="10,0,0,0"
                                  Checked="Tailscale_Changed" Unchecked="Tailscale_Changed"
                                  ToolTip="For when your router or internet provider blocks the game. Install Tailscale, accept the share of the Vanadreams server you were sent, then tick this and Save."/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Username" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="UserBox" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Text="Password" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="PassBox" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Text="Boot file" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="4" Grid.Column="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="BootBox" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="…" Padding="10,2" Margin="6,0,0,0" Click="Browse_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="5" Text="Game folder" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="5" Grid.Column="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="GameBox" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="GameBrowse" Style="{StaticResource GhostButton}" Content="…" Padding="10,2" Margin="6,0,0,0" Click="GameBrowse_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="6" Text="Extra loader args" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="ExtraBox" VerticalAlignment="Center"/>
                    <!-- window mode and size are on the Graphics page; the menu follows the window unless set here -->
                    <TextBlock Grid.Row="7" Text="Menu size" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" ToolTip="The size the game draws its menus at. Blank follows the window size on the Graphics page.">
                        <TextBox x:Name="MenuWBox" Width="64" VerticalAlignment="Center"/>
                        <TextBlock Text=" × " VerticalAlignment="Center"/>
                        <TextBox x:Name="MenuHBox" Width="64" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="8" Text="Background" Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <WrapPanel Grid.Row="8" Grid.Column="1"
                                ToolTip="The resolution the game draws the world at. Higher is sharper and asks more of your graphics card: twice or four times the window size is usual, 4096 × 4096 is common. Leave blank for the game's own default.">
                        <StackPanel Orientation="Horizontal" Height="30" Margin="0,0,12,0">
                            <TextBox x:Name="BgWBox" Width="64" VerticalAlignment="Center"/>
                            <TextBlock Text=" × " VerticalAlignment="Center"/>
                            <TextBox x:Name="BgHBox" Width="64" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="blank for default" Style="{StaticResource Muted}" FontSize="13.5" VerticalAlignment="Center" Height="30" Padding="0,6,0,0"/>
                    </WrapPanel>
                    <WrapPanel Grid.Row="9" Grid.Column="1" Margin="0,4,0,0">
                        <CheckBox x:Name="AutoCloseBox" VerticalAlignment="Center" Margin="0,0,18,4">
                            <TextBlock Text="Close the launcher after launching" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="AdminBox" Content="Run as administrator" VerticalAlignment="Center" Margin="0,0,0,4"
                                  ToolTip="Asks Windows' permission on every launch. Leave it off unless this game needs it: the prompt can close a game that is already running."/>
                    </WrapPanel>
                </Grid>
                <DockPanel Grid.Row="2" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Left" Style="{StaticResource GoldButton}" Content="Save" Click="Save_Click" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Note" Style="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
