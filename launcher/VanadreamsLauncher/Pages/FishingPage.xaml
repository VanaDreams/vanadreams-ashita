<UserControl x:Class="Vanadreams.Pages.FishingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vanadreams"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="Heading" Style="{StaticResource Eyebrow}" Text="✦ Catch log" TextTrimming="CharacterEllipsis"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Log">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding When}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="14" Foreground="{Binding Brush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding What}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Bite}" Style="{StaticResource Muted}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Skill}" Style="{StaticResource Mono}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Fishing"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Display40}" FontSize="29" Text="vanafish"/>
                        <TextBlock x:Name="State" Style="{StaticResource Mono}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                        <CheckBox x:Name="EnabledBox" Click="Enabled_Click">
                            <TextBlock Text="Load the fishing addon at startup" TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap" Margin="0,10,0,0" Text="In game: /&#x2060;vanafish opens the window, /&#x2060;vanafish start fishes. Rod in the ranged slot, bait in the ammo slot, stand at a spot. What to keep, timing and the stop rules are set in the game window and kept per character."/>
                        <TextBlock x:Name="Totals" Style="{StaticResource Mono}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Open catch log folder" Click="Folder_Click" HorizontalAlignment="Left"/>
                    <local:CrewGuide Who="chocobo" Flip="True" BubbleWidth="140"
                                     Tip="Kweh! Rod in the ranged slot, bait in ammo, then type&#160;/&#x2060;vanafish start."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
