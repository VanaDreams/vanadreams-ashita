<UserControl x:Class="Vanadreams.Pages.MenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="262"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Login and Play -->
        <Border Grid.Column="0" Style="{StaticResource Box}">
            <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Login"/>
                <TextBlock Text="Username" Style="{StaticResource Eyebrow}" FontSize="13" Typography.Capitals="Normal" Margin="0,2,0,3"/>
                <TextBox x:Name="UserBox"/>
                <TextBlock Text="Password" Style="{StaticResource Eyebrow}" FontSize="13" Typography.Capitals="Normal" Margin="0,10,0,3"/>
                <PasswordBox x:Name="PassBox"/>
                <CheckBox x:Name="RememberBox" Margin="0,12,0,0" IsChecked="True"
                          ToolTip="Keeps this profile's login on this PC, protected by Windows. Untick it and the launcher forgets it.">
                    <TextBlock Text="Remember me" Style="{StaticResource Muted}"/>
                </CheckBox>
                <Button x:Name="PlayButton" Style="{StaticResource GoldButton}" Content="▶  Play" FontSize="19" Padding="34,10"
                        HorizontalAlignment="Left" Margin="0,18,0,0" MinWidth="150" Click="Play_Click"/>
                <TextBlock x:Name="PlayNote" Style="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0">
                    <Run x:Name="ProfileLine" Text="Profile: —"/>
                    <Run Text=" · "/>
                    <Hyperlink x:Name="ChangeLink" Foreground="{StaticResource GoldSoft}" Click="Change_Click">change</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Vana'News, the patch, and the crew -->
        <Border Grid.Column="2" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Vana'News"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
                    <StackPanel Margin="0,0,8,0">
                        <ItemsControl x:Name="NewsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Byline}" Foreground="{StaticResource GoldSoft}" FontSize="12.5" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource NavText}" FontSize="17.5" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                            <TextBlock Text="{Binding Body}" FontSize="15" TextWrapping="Wrap" LineHeight="21"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoNews" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="No news yet. Rates, rules and status are on fairywitch.ca."/>
                    </StackPanel>
                </ScrollViewer>
                <!-- its own row under a gold hairline: the news scrolls above it and never runs into it -->
                <Border Grid.Row="2" x:Name="PatchPanel" Margin="0,8,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="PatchText" Foreground="{StaticResource GoldSoft}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="PatchBar" Margin="0,6,0,0" Minimum="0" Maximum="100" Height="10" BorderThickness="1">
                        <ProgressBar.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF9C6428" Offset="0"/>
                                <GradientStop Color="#FFD6A74C" Offset="0.6"/>
                                <GradientStop Color="#FFF1CD78" Offset="1"/>
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                    </ProgressBar>
                </StackPanel>
                </Border>
                <StackPanel Grid.Row="3" x:Name="Crew" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
