<UserControl x:Class="Vanadreams.Pages.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vanadreams"
             xmlns:pages="clr-namespace:Vanadreams.Pages"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Heading" Style="{StaticResource Eyebrow}" Text="✦ Setup"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock x:Name="Title" Style="{StaticResource Display40}" FontSize="25" TextWrapping="Wrap" Text="Set up Ashita for Vanadreams"/>
                        <TextBlock x:Name="Lede" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14" Text="This downloads the Ashita v4 beta and the loader, unpacks them into a folder you choose, and writes the Vanadreams profile. It never touches the FFXI client itself."/>
                        <TextBlock Text="Ashita folder" Style="{StaticResource Muted}"/>
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderBox"/>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Choose…" Padding="12,3" Margin="8,0,0,0" Click="Choose_Click"/>
                        </Grid>
                        <StackPanel x:Name="ImportPanel" Visibility="Collapsed">
                            <TextBlock x:Name="ImportLabel" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <CheckBox x:Name="ImportProfiles" Content="Bring my v3 profiles over" IsChecked="True" Margin="0,4,0,2"/>
                            <CheckBox x:Name="ImportConfigs" IsChecked="True" Margin="0,2,0,10">
                                <TextBlock Text="Copy the configs that carry over (MultiSend, Lootwhore, Ashitacast, XIPivot)" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                        <ProgressBar x:Name="Progress" Visibility="Collapsed" Margin="0,4,0,4"/>
                        <TextBlock x:Name="Status" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button x:Name="GoButton" Style="{StaticResource GoldButton}" Content="Download and set up" Click="Go_Click" Margin="0,0,10,6"/>
                    <Button x:Name="AdoptButton" Style="{StaticResource GhostButton}" Content="Use this folder as it is" Margin="0,0,10,6" Click="Adopt_Click" Visibility="Collapsed"/>
                    <Button Style="{StaticResource GhostButton}" Content="Install game" Margin="0,0,0,6" Click="InstallGame_Click"/>
                </WrapPanel>
                <!-- under Check and update, in its own control so it can move -->
                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Margin="0,4,0,0" Padding="0,8,0,0">
                    <pages:BugReportPanel/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Box}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Style="{StaticResource Eyebrow}" Text="✦ What happens"/>
                        <TextBlock x:Name="Step1" TextWrapping="Wrap" FontSize="14.5" Margin="0,0,0,7" Text="1. Ashita v4 beta downloads from its GitHub repository."/>
                        <TextBlock x:Name="Step2" TextWrapping="Wrap" FontSize="14.5" Margin="0,0,0,7" Text="2. xiloader downloads from LandSandBoat's releases into the bootloader folder."/>
                        <TextBlock x:Name="Step3" TextWrapping="Wrap" FontSize="14.5" Margin="0,0,0,7" Text="3. The Vanadreams profile is written with the server address and the startup script."/>
                        <TextBlock x:Name="Step4" TextWrapping="Wrap" FontSize="14.5" Margin="0,0,0,7" Text="4. If a v3 Ashita is found, profiles and configs come across."/>
                        <TextBlock x:Name="Step5" TextWrapping="Wrap" FontSize="14.5" Margin="0,0,0,7" Text="5. You land on the menu with Vanadreams selected. Make your account at the loader prompt on first Play."/>
                    </StackPanel>
                </ScrollViewer>
                <local:CrewGuide Grid.Row="1" Who="goblin" BubbleWidth="140"
                                 Tip="Me check every bolt. Run Setup again any time: only what changed comes down."/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
